# Single-host front door WITHOUT a DNS API (free-plan / sslip.io setup).
#   https://{$API_DOMAIN}                -> api:8000 (REST + SSE, unbuffered)
#   https://<token>.{$PREVIEW_DOMAIN}    -> api:8000, one on-demand certificate per live preview,
#                                           gated by the API (GET /_caddy/ask).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/_caddy/ask
	}
	servers {
		timeouts {
			idle 1h
		}
	}
}

(api_upstream) {
	reverse_proxy api:8000 {
		flush_interval -1
		transport http {
			read_timeout 1h
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	import api_upstream
}

https:// {
	tls {
		on_demand
	}
	import api_upstream
}
