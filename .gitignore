# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data (never commit)
dump.rdb
*.rdb
backend/sessions/
sessions/
