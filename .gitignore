*.url
cf-*.lock
lr-*.lock
cloudflared

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.auto.tfvars
terraform.tfvars
!terraform.tfvars.example
infra/terraform/backend.hcl

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Vite timestamp files
vite.config.ts.timestamp-*

# Release artefacts
*.zip
