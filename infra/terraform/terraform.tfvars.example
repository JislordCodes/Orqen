# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
region         = "eu-west-1"
environment    = "prod"
domain_name    = "example.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

cors_origins      = ["https://orqen.vercel.app"]
cors_origin_regex = "" # e.g. "^https://orqen-[a-z0-9-]+-yourteam\\.vercel\\.app$"

auth_mode    = "jwt"
jwt_jwks_url = "https://YOUR_TENANT.eu.auth0.com/.well-known/jwks.json"
jwt_issuer   = "https://YOUR_TENANT.eu.auth0.com/"
jwt_audience = "https://api.example.com"

worker_instance_type       = "m6i.xlarge"
worker_desired_capacity    = 1
worker_max_concurrent_runs = 3

alarm_email = "ops@example.com"
github_repo = "WaleX-projects/orqen"
