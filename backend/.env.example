# Copy to .env and fill in. Only the WORKER reads ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
REDIS_URL=redis://localhost:6379

# Sandbox
SANDBOX_IMAGE=appbuilder-sandbox:latest
SANDBOX_NETWORK=bridge
SANDBOX_MEM=1g
SANDBOX_CPUS=1.0

# Worker limits
MAX_CONCURRENT_RUNS=4
MAX_TOOL_CALLS=80

# Preview. Wildcard domain that points at THIS server. Without your own domain you can use
# nip.io: for a server at 3.80.104.25 set PREVIEW_DOMAIN=3.80.104.25.nip.io
PREVIEW_DOMAIN=
PREVIEW_PORT=3000

# Where chat history is stored (per project)
SESSIONS_DIR=./sessions
