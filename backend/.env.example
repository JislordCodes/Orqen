# Orqen backend configuration. Copy to backend/.env for local dev; in production set these as
# container environment / secrets (see docs/ENV.md for the full reference).
# Never commit a filled-in .env.

# ---------------------------------------------------------------- general
# dev | production. "production" switches the default log format to JSON. Nothing else.
APP_ENV=dev
LOG_LEVEL=INFO
# text | json (default: json when APP_ENV=production)
LOG_FORMAT=

# ---------------------------------------------------------------- redis (API + worker)
# redis://host:6379 locally; rediss://<elasticache-endpoint>:6379 for TLS in AWS.
REDIS_URL=redis://localhost:6379
# AUTH token (ElastiCache). SECRET. Leave empty locally.
REDIS_PASSWORD=

# ---------------------------------------------------------------- LLM (WORKER ONLY; the API never needs it)
# SECRET. Nebius AI Studio key (any OpenAI-compatible provider works with BASE_URL).
NEBIUS_API_KEY=
BASE_URL=https://api.studio.nebius.com/v1/
MODEL_ID=zai-org/GLM-5.3
# Optional stronger model for the planner. Empty = MODEL_ID.
PLANNER_MODEL_ID=
MAX_TOKENS=32000
CONTEXT_WINDOW=131072

# ---------------------------------------------------------------- API: CORS + auth
# Comma-separated exact origins allowed to call the API (your Vercel domain in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
# Optional regex for extra origins, e.g. Vercel preview deployments:
# CORS_ORIGIN_REGEX=^https://orqen-[a-z0-9-]+-yourteam\.vercel\.app$
CORS_ORIGIN_REGEX=
# dev = trust X-User-Id (local only!)  |  jwt = verify Authorization: Bearer <JWT> against a JWKS
AUTH_MODE=dev
# Required when AUTH_MODE=jwt, e.g. https://YOUR_TENANT.auth0.com/.well-known/jwks.json
JWT_JWKS_URL=
# Recommended with jwt: expected "iss" and "aud" claims (empty = not checked).
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=RS256
# Claim that holds the user id.
JWT_USER_CLAIM=sub

# ---------------------------------------------------------------- sandboxes (WORKER)
SANDBOX_IMAGE=appbuilder-sandbox:latest
# host = share the host network (single-box dev; one preview at a time)
# bridge = own network per sandbox, preview port published on a random host port (production)
SANDBOX_NETWORK=bridge
# How the API reaches this worker host's published ports (EC2: the private IP; set by user-data).
SANDBOX_ADVERTISE_HOST=127.0.0.1
# Interface published sandbox ports bind to.
SANDBOX_PUBLISH_IP=0.0.0.0
# Optional stronger isolation runtime: runsc (gVisor) or sysbox-runc. Empty = default runc.
SANDBOX_RUNTIME=
SANDBOX_MEM=3g
SANDBOX_CPUS=1.0

# ---------------------------------------------------------------- worker limits + lifecycle
MAX_CONCURRENT_RUNS=4
MAX_TOOL_CALLS=80
MAX_SESSIONS=6
# Seconds a SIGTERM'd worker lets runs finish before cancelling and re-queueing them.
WORKER_SHUTDOWN_GRACE=120
MAX_JOB_ATTEMPTS=3
WORKER_HEARTBEAT_TTL=30
# Port for the worker's /health and /ready (0 = off).
WORKER_HEALTH_PORT=0
# 0 disables the headless Chromium UI check. CHROMIUM_BIN overrides the browser path.
UI_CHECK=1
CHROMIUM_BIN=

# ---------------------------------------------------------------- preview links (API)
PREVIEW_PORT=3000
# Wildcard domain whose subdomains reach the API, e.g. preview.example.com (or <ip>.nip.io in dev).
PREVIEW_DOMAIN=
# https behind ALB/Caddy with a wildcard cert (no port in links); http in dev.
PREVIEW_SCHEME=http
PREVIEW_TTL=86400
# Single-box demo alternative: a tunnel URL pointed at PREVIEW_PORT, or a file holding it.
PREVIEW_URL=
PREVIEW_URL_FILE=

# ---------------------------------------------------------------- durable state
# Chat history. Local dir (single worker host) or S3 (several hosts).
SESSIONS_DIR=./sessions
SESSIONS_S3_BUCKET=
SESSIONS_S3_PREFIX=sessions/
# Project snapshots (tar.gz of each workspace). Empty SNAPSHOT_DIR disables snapshots entirely.
SNAPSHOT_DIR=./snapshots
SNAPSHOT_EVERY=15
# Also copy snapshots to S3 and restore from there on a new host.
SNAPSHOT_S3_BUCKET=
SNAPSHOT_S3_PREFIX=snapshots/
# Region for S3 (defaults to the AWS SDK's region resolution).
AWS_REGION=
