# Orqen worker: runs the Strands agent and drives one Docker sandbox per project through the HOST's
# Docker daemon (mount /var/run/docker.sock). Includes Chromium for the headless UI check.
#   docker build -t orqen-worker -f backend/Dockerfile.worker backend
# Run (the socket's group id varies per host, so pass it with --group-add):
#   docker run -v /var/run/docker.sock:/var/run/docker.sock --group-add $(stat -c %g /var/run/docker.sock) ...
FROM python:3.12-slim-bookworm AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt

FROM python:3.12-slim-bookworm
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production LOG_FORMAT=json \
    CHROMIUM_BIN=/usr/bin/chromium \
    SESSIONS_DIR=/data/sessions SNAPSHOT_DIR=/data/snapshots \
    WORKER_HEALTH_PORT=8081
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium fonts-liberation fonts-noto-color-emoji ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin orqen \
    && mkdir -p /data/sessions /data/snapshots && chown -R orqen:orqen /data
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY --chown=orqen:orqen app ./app
USER orqen
VOLUME ["/data"]
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8081/health || exit 1
# tini forwards SIGTERM to python so the worker drains (WORKER_SHUTDOWN_GRACE) instead of being killed.
# Give the container a matching stop timeout: docker stop -t / compose stop_grace_period.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "app.worker"]
