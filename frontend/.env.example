# Orqen frontend build-time configuration (Vite inlines VITE_* at build time, so every value here is
# PUBLIC: never put a secret in a VITE_ variable). On Vercel set them under Project > Settings > Environment Variables.

# Address of the Orqen API (backend/app/api.py), no trailing slash.
# Local: http://localhost:8000   Production: https://api.<your-domain>
# Leave empty to start in Demo mode (no backend).
VITE_API_URL=http://localhost:8000

# Dev-only auth: the backend (AUTH_MODE=dev) trusts this id (X-User-Id). It names your sandbox container.
# Ignored by a backend running AUTH_MODE=jwt.
VITE_USER_ID=demo-user

# Auth for AUTH_MODE=jwt backends. The app sends "Authorization: Bearer <token>" (and ?access_token= on the
# SSE stream) whenever a token is available. Token sources, first match wins:
#   1. window.orqenAuth.getToken() - set by your auth SDK integration (see src/lib/auth.ts)
#   2. localStorage[VITE_AUTH_TOKEN_STORAGE_KEY]
VITE_AUTH_TOKEN_STORAGE_KEY=orqen_token

# Force the SSE long-poll fallback (only for tunnels that buffer streams). Automatic on *.trycloudflare.com.
# Leave unset in production: the browser streams events straight from the API.
VITE_SSE_POLL=

# Base path for the build (GitHub Pages demo uses /orqen/). Vercel: leave unset.
# VITE_BASE=/orqen/
